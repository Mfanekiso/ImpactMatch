
{
  "expo": {
    "name": "ImpactMatch",
    "slug": "ImpactMatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/impactmatch-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/impactmatch-logo.png",
        "backgroundColor": "#F8F6EE"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/impactmatch-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6EE"
        }
      ]
    ]
  }
}
